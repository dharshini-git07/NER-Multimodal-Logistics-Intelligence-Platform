# FastAPI REST endpoint used by the local Vite dashboard.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Vite proxy target (used only when VITE_API_BASE_URL is set to a relative path).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
# FastAPI WebSocket endpoint for live vehicle and alert updates.
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry
